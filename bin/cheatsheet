#!/usr/bin/env zsh
# cheatsheet — fuzzy-searchable tool cheatsheets, rendered in the terminal.
#
#   cheatsheet [query]      fuzzy full-text search over every line of every
#                           sheet (matches tool names and content together),
#                           preview centred on the hit; optional initial query
#   cheatsheet -l|--list    browse sheets by name (rendered glow preview)
#
# Enter opens the selected sheet rendered (glow when available, bat otherwise).

set -euo pipefail

SHEET_DIR="${CHEATSHEET_DIR:-$HOME/.dotfiles/cheatsheet}"

if ! command -v fzf >/dev/null; then
    echo "cheatsheet: fzf is required" >&2
    exit 1
fi
if [[ ! -d "$SHEET_DIR" ]]; then
    echo "cheatsheet: no such directory: $SHEET_DIR" >&2
    exit 1
fi

# Open a sheet full-screen.
view() {
    if command -v glow >/dev/null; then
        glow -p "$1"
    else
        bat --language=markdown --style=plain --paging=always "$1"
    fi
}

# fzf preview command strings ($FZF_PREVIEW_COLUMNS is expanded by fzf's
# preview shell at render time, hence single quotes).
if command -v glow >/dev/null; then
    preview_sheet='glow -s dark -w $FZF_PREVIEW_COLUMNS {}.md'
else
    preview_sheet='bat --color=always --language=markdown --style=plain {}.md'
fi

cd "$SHEET_DIR"

if [[ "${1:-}" == "-l" || "${1:-}" == "--list" ]]; then
    # List mode: pick a tool by name, preview the rendered sheet.
    local sheet
    sheet=$(for f in *.md; do print -r -- "${f%.md}"; done | fzf \
        --prompt='cheatsheet> ' \
        --preview="$preview_sheet" \
        --preview-window='right,70%,wrap' \
        --bind='ctrl-/:change-preview-window(down,70%,wrap|right,70%,wrap)') || return 0
    view "$sheet.md"
else
    # Search mode (default): fuzzy over every entry of every sheet, indexed as
    # "sheet › section › content" so section names match too and the list
    # stays readable (table pipes tidied, separators/fences skipped).
    # Index fields are tab-separated: file, line, styled display text.
    build_index() {
        awk '
        # Entries are held one line before printing so a table header row can
        # be discarded when the following line reveals it (|---|---| separator).
        function flush() { if (pending != "") { print pending; pending = "" } }
        FNR == 1 { flush(); section = ""; incode = 0
                   sheet = FILENAME; sub(/\.md$/, "", sheet) }
        /^```/ { flush(); incode = !incode; next }
        incode == 0 && /^#+[ \t]/ {
            flush()
            text = $0; sub(/^#+[ \t]+/, "", text)
            if (length($1) == 1) { section = ""; next }   # H1 = sheet title
            section = text
            printf "%s.md\t%d\t\033[36m%s\033[0m \033[2m›\033[0m \033[1m%s\033[0m\n", \
                sheet, FNR, sheet, text
            next
        }
        /^[ \t]*$/ { flush(); next }
        /^-+$/ { flush(); next }
        /^\|[ :|-]+\|$/ { pending = ""; next }            # drop held header row
        {
            flush()
            text = $0
            gsub(/^[ \t]+/, "", text); gsub(/[ \t]+$/, "", text)
            if (text ~ /^\|.*\|$/) {                      # table row -> a · b
                sub(/^\|[ \t]*/, "", text)
                sub(/[ \t]*\|$/, "", text)
                gsub(/[ \t]*\|[ \t]*/, "  \033[2m·\033[0m  ", text)
            }
            if (section != "")
                pending = sprintf("%s.md\t%d\t\033[36m%s\033[0m \033[2m› %s ›\033[0m %s", \
                    sheet, FNR, sheet, section, text)
            else
                pending = sprintf("%s.md\t%d\t\033[36m%s\033[0m \033[2m›\033[0m %s", \
                    sheet, FNR, sheet, text)
        }
        END { flush() }
        ' *.md
    }
    local match
    match=$(build_index | fzf \
        --ansi \
        --prompt='cheatsheet> ' \
        --query="${*:-}" \
        --delimiter=$'\t' \
        --nth=3 \
        --with-nth=3 \
        --preview='bat --color=always --language=markdown --style=numbers --highlight-line {2} {1}' \
        --preview-window='right,55%,wrap,+{2}/2' \
        --bind='ctrl-/:change-preview-window(down,70%,wrap|right,55%,wrap)') || return 0
    view "${match%%$'\t'*}"
fi
