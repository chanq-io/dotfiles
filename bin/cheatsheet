#!/usr/bin/env zsh
# cheatsheet — fuzzy-searchable tool cheatsheets, rendered in the terminal.
#
#   cheatsheet [query]      fuzzy full-text search over every entry of every
#                           sheet (tool names, section names, and content all
#                           match); preview shows the matched section rendered
#   cheatsheet -l|--list    browse sheets by name (rendered glow preview)
#
# Enter opens the selected sheet rendered (glow when available, bat otherwise).

set -euo pipefail

SHEET_DIR="${CHEATSHEET_DIR:-$HOME/.dotfiles/cheatsheet}"
self="${0:A}"

if ! command -v fzf >/dev/null; then
    echo "cheatsheet: fzf is required" >&2
    exit 1
fi
if [[ ! -d "$SHEET_DIR" ]]; then
    echo "cheatsheet: no such directory: $SHEET_DIR" >&2
    exit 1
fi

# Open a sheet full-screen.
view() {
    if command -v glow >/dev/null; then
        glow -p "$1"
    else
        bat --language=markdown --style=plain --paging=always "$1"
    fi
}

# fzf preview command strings ($FZF_PREVIEW_COLUMNS is expanded by fzf's
# preview shell at render time, hence single quotes).
if command -v glow >/dev/null; then
    preview_sheet='glow -s dark -w $FZF_PREVIEW_COLUMNS {}.md'
else
    preview_sheet='bat --color=always --language=markdown --style=plain {}.md'
fi

cd "$SHEET_DIR"

if [[ "${1:-}" == "--render-section" ]]; then
    # Internal (fzf preview): render the section of $2 starting at line $3.
    # The slice runs to the next heading at the same or higher level (a start
    # line before any H2, i.e. the sheet intro, runs to the first H2).
    awk -v s="$3" '
    NR == s { n = 0; if ($0 ~ /^#+[ \t]/) n = length($1)
              lvl = (n < 2) ? 2 : n; print; next }
    NR > s { if ($0 ~ /^#+[ \t]/ && length($1) <= lvl) exit; print }
    ' "$2" | {
        if command -v glow >/dev/null; then
            glow -s dark -w "${FZF_PREVIEW_COLUMNS:-100}" -
        else
            bat --color=always --language=markdown --style=plain
        fi
    }
elif [[ "${1:-}" == "-l" || "${1:-}" == "--list" ]]; then
    # List mode: pick a tool by name, preview the rendered sheet.
    local sheet
    sheet=$(for f in *.md; do print -r -- "${f%.md}"; done | fzf \
        --prompt='cheatsheet> ' \
        --preview="$preview_sheet" \
        --preview-window='right,70%,wrap' \
        --bind='ctrl-/:change-preview-window(down,70%,wrap|right,70%,wrap)') || return 0
    view "$sheet.md"
else
    # Search mode (default): fuzzy over every entry of every sheet, indexed as
    # "sheet › section › content" so section names match too and the list
    # stays readable (table pipes tidied, separators/fences skipped).
    # Index fields are tab-separated: file, line, styled display text, section
    # start line. fzf shows and matches only the display text (--with-nth
    # transforms the line before matching, so no --nth on top of it).
    build_index() {
        awk '
        # Entries are held one line before printing so a table header row can
        # be discarded when the following line reveals it (|---|---| separator).
        function flush() { if (pending != "") { print pending; pending = "" } }
        FNR == 1 { flush(); section = ""; incode = 0; secstart = 1
                   sheet = FILENAME; sub(/\.md$/, "", sheet) }
        /^```/ { flush(); incode = !incode; next }
        incode == 0 && /^#+[ \t]/ {
            flush()
            text = $0; sub(/^#+[ \t]+/, "", text)
            if (length($1) == 1) { section = ""; next }   # H1 = sheet title
            section = text; secstart = FNR
            printf "%s.md\t%d\t\033[36m%s\033[0m \033[2m›\033[0m \033[1m%s\033[0m\t%d\n", \
                sheet, FNR, sheet, text, FNR
            next
        }
        /^[ \t]*$/ { flush(); next }
        /^-+$/ { flush(); next }
        /^\|[ :|-]+\|$/ { pending = ""; next }            # drop held header row
        {
            flush()
            text = $0
            gsub(/^[ \t]+/, "", text); gsub(/[ \t]+$/, "", text)
            if (text ~ /^\|.*\|$/) {                      # table row -> a · b
                sub(/^\|[ \t]*/, "", text)
                sub(/[ \t]*\|$/, "", text)
                gsub(/[ \t]*\|[ \t]*/, "  \033[2m·\033[0m  ", text)
            }
            if (section != "")
                pending = sprintf("%s.md\t%d\t\033[36m%s\033[0m \033[2m› %s ›\033[0m %s\t%d", \
                    sheet, FNR, sheet, section, text, secstart)
            else
                pending = sprintf("%s.md\t%d\t\033[36m%s\033[0m \033[2m›\033[0m %s\t%d", \
                    sheet, FNR, sheet, text, secstart)
        }
        END { flush() }
        ' *.md
    }
    local match
    match=$(build_index | fzf \
        --ansi \
        --prompt='cheatsheet> ' \
        --query="${*:-}" \
        --delimiter=$'\t' \
        --with-nth=3 \
        --preview="$self --render-section {1} {4}" \
        --preview-window='right,55%,wrap' \
        --bind='ctrl-/:change-preview-window(down,70%,wrap|right,55%,wrap)') || return 0
    view "${match%%$'\t'*}"
fi
