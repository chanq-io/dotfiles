#!/usr/bin/env zsh
# cheatsheet — fuzzy-searchable tool cheatsheets, rendered in the terminal.
#
#   cheatsheet [query]      fuzzy full-text search over every entry of every
#                           sheet (tool names, section names, and content all
#                           match); preview shows the matched section rendered.
#                           enter: page the section  ctrl-o: page the full
#                           sheet  esc: quit. Viewers return to the search.
#   cheatsheet -l|--list    browse sheets by name (rendered glow preview)
#
# Rendering uses glow when available, bat otherwise.

set -euo pipefail

SHEET_DIR="${CHEATSHEET_DIR:-$HOME/.dotfiles/cheatsheet}"
self="${0:A}"

if ! command -v fzf >/dev/null; then
    echo "cheatsheet: fzf is required" >&2
    exit 1
fi
if [[ ! -d "$SHEET_DIR" ]]; then
    echo "cheatsheet: no such directory: $SHEET_DIR" >&2
    exit 1
fi

render_width() {
    local w="${FZF_PREVIEW_COLUMNS:-$(tput cols 2>/dev/null || echo 100)}"
    (( w > 110 )) && w=110
    print -r -- "$w"
}

# Render markdown from stdin at a given width.
render_md() {
    if command -v glow >/dev/null; then
        glow -s dark -w "$1" -
    else
        bat --color=always --language=markdown --style=plain
    fi
}

# Slice one section out of a sheet: from line $2 to the next heading at the
# same or higher level (a start line before any H2, i.e. the sheet intro,
# runs to the first H2).
slice_section() {
    awk -v s="$2" '
    NR == s { n = 0; if ($0 ~ /^#+[ \t]/) n = length($1)
              lvl = (n < 2) ? 2 : n; print; next }
    NR > s { if ($0 ~ /^#+[ \t]/ && length($1) <= lvl) exit; print }
    ' "$1"
}

# Page a whole sheet (glow pager; q returns to the caller).
view_sheet() {
    if command -v glow >/dev/null; then
        glow -p "$1"
    else
        bat --language=markdown --style=plain --paging=always "$1"
    fi
}

cd "$SHEET_DIR"

case "${1:-}" in
--render-section)   # internal (fzf preview): rendered section to stdout
    slice_section "$2" "$3" | render_md "$(render_width)"
    exit 0
    ;;
--view-section)     # internal (fzf enter): rendered section in a pager
    slice_section "$2" "$3" | render_md "$(render_width)" | less -R
    exit 0
    ;;
--view-sheet)       # internal (fzf ctrl-o / list mode enter): whole sheet
    view_sheet "$2"
    exit 0
    ;;
esac

if command -v glow >/dev/null; then
    preview_sheet='glow -s dark -w $FZF_PREVIEW_COLUMNS {}.md'
else
    preview_sheet='bat --color=always --language=markdown --style=plain {}.md'
fi

if [[ "${1:-}" == "-l" || "${1:-}" == "--list" ]]; then
    # List mode: pick a tool by name, page the rendered sheet, q returns.
    for f in *.md; do print -r -- "${f%.md}"; done | fzf \
        --prompt='cheatsheet> ' \
        --header='enter: view sheet · esc: quit' \
        --preview="$preview_sheet" \
        --preview-window='right,70%,wrap' \
        --bind="enter:execute($self --view-sheet {}.md)" \
        --bind='ctrl-/:change-preview-window(down,70%,wrap|right,70%,wrap)' || true
else
    # Search mode (default): fuzzy over every entry of every sheet. Rows are
    # fixed-width columns — "sheet │ content… ‹ section" — with the content
    # hard-truncated so the list reads as a table; --no-hscroll keeps rows
    # left-anchored instead of scrolling to expose the matched characters.
    # Section-heading rows are bold and act as dividers; the section suffix
    # keeps section terms matchable (e.g. "telekasten").
    # Index fields are tab-separated: file, line, styled display text, section
    # start line. fzf shows and matches only the display text (--with-nth
    # transforms the line before matching, so no --nth on top of it).
    build_index() {
        # LC_ALL=C forces byte semantics: macOS awk is otherwise UTF-8-aware
        # (and errors on stray non-UTF-8 bytes in sheet content), while the
        # truncation/padding logic below is written for bytes.
        LC_ALL=C awk '
        # Truncate to roughly max bytes without splitting a UTF-8 sequence.
        function vtrunc(s, max) {
            if (length(s) <= max) return s
            s = substr(s, 1, max - 1)
            sub(/[\300-\367][\200-\277]*$/, "", s)
            return s "…"
        }
        # Pad to w display columns, compensating for multibyte characters
        # (padding is byte-based; each lead byte class hides 1-3 extra bytes).
        function vpad(s, w,   extra, fmt) {
            extra = gsub(/[\302-\337]/, "&", s) \
                  + 2 * gsub(/[\340-\357]/, "&", s) \
                  + 3 * gsub(/[\360-\367]/, "&", s)
            fmt = "%-" (w + extra) "s"
            return sprintf(fmt, s)
        }
        # Entries are held one line before printing so a table header row can
        # be discarded when the following line reveals it (|---|---| separator).
        function flush() { if (pending != "") { print pending; pending = "" } }
        FNR == 1 { flush(); section = ""; incode = 0; secstart = 1
                   sheet = FILENAME; sub(/\.md$/, "", sheet) }
        /^```/ { flush(); incode = !incode; next }
        incode == 0 && /^#+[ \t]/ {
            flush()
            text = $0; sub(/^#+[ \t]+/, "", text)
            if (length($1) == 1) { section = ""; next }   # H1 = sheet title
            section = text; secstart = FNR
            printf "%s.md\t%d\t\033[36m%-14.14s\033[0m \033[2m│\033[0m \033[1m%s\033[0m\t%d\n", \
                sheet, FNR, sheet, text, FNR
            next
        }
        /^[ \t]*$/ { flush(); next }
        /^-+$/ { flush(); next }
        /^\|[ :|-]+\|$/ { pending = ""; next }            # drop held header row
        {
            flush()
            text = $0
            gsub(/\t/, " ", text)
            gsub(/^[ \t]+/, "", text); gsub(/[ \t]+$/, "", text)
            if (text ~ /^\|.*\|$/) {                      # table row -> a · b
                sub(/^\|[ \t]*/, "", text)
                sub(/[ \t]*\|$/, "", text)
                gsub(/[ \t]*\|[ \t]*/, " · ", text)
            }
            text = vpad(vtrunc(text, 56), 56)
            gsub(/ · /, " \033[2m·\033[0m ", text)        # dim separators last
            if (section != "")
                pending = sprintf("%s.md\t%d\t\033[36m%-14.14s\033[0m \033[2m│\033[0m %s \033[2m‹ %s\033[0m\t%d", \
                    sheet, FNR, sheet, text, vtrunc(section, 30), secstart)
            else
                pending = sprintf("%s.md\t%d\t\033[36m%-14.14s\033[0m \033[2m│\033[0m %s\t%d", \
                    sheet, FNR, sheet, text, secstart)
        }
        END { flush() }
        ' *.md
    }
    build_index | fzf \
        --ansi \
        --no-hscroll \
        --layout=reverse \
        --prompt='cheatsheet> ' \
        --query="${*:-}" \
        --delimiter=$'\t' \
        --with-nth=3 \
        --header='enter: view section · ctrl-o: full sheet · ctrl-/: preview · esc: quit' \
        --preview="$self --render-section {1} {4}" \
        --preview-window='right,55%,wrap' \
        --bind="enter:execute($self --view-section {1} {4})" \
        --bind="ctrl-o:execute($self --view-sheet {1})" \
        --bind='ctrl-/:change-preview-window(hidden|down,70%,wrap|right,55%,wrap)' || true
fi
